---
import { LinkButton } from '@astrojs/starlight/components';
import { Image } from 'astro:assets';
import heroImage from '../assets/jsonql-hero-banner-logos.png';
---

<div class="custom-hero">
  <div class="hero-text">
    <h1 class="hero-title">JSONQL</h1>
    <p class="hero-tagline">Build data APIs that speak JSON from end to end.</p>
    <div class="hero-actions">
      <LinkButton href="/getting-started/" icon="right-arrow" variant="primary">
        Get Started
      </LinkButton>
      <LinkButton href="/sdk/go/" variant="secondary">
        Explore SDKs
      </LinkButton>
      <LinkButton href="https://github.com/JSONQL-Standard" icon="external" variant="minimal">
        GitHub
      </LinkButton>
    </div>
  </div>
  <div class="hero-anim">
    <Image src={heroImage} alt="JSONQL Diagram" loading="eager" />
  </div>
</div>

<style>
  .custom-hero {
    display: flex;
    flex-direction: column-reverse;
    gap: 2rem;
    padding: 3rem 0;
    align-items: center;
    text-align: center;
  }
  
  @media (min-width: 768px) {
    .custom-hero {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
    }
    .hero-text {
      flex: 1;
      max-width: 50%;
    }
    .hero-anim {
      flex: 1;
      width: 100%;
    }
    .hero-anim img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }
    .hero-actions {
      justify-content: flex-start;
    }
  }

  .hero-title {
    font-size: var(--sl-text-5xl) !important;
    line-height: 1.1;
    font-weight: 900;
    margin-bottom: 1rem;
    background: linear-gradient(to right, var(--sl-color-white), var(--sl-color-accent-high));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-tagline {
    font-size: var(--sl-text-xl);
    color: var(--sl-color-gray-2);
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
</style>
